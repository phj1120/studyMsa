### =============================================================
### Tenant Admin - http://localhost:9003
### =============================================================


### ----------------------------------------------------------------
### Service Key 관리
### ----------------------------------------------------------------

### 서비스 키 생성
POST {{admin_url}}/api/v1/tenants/{{tenant_id}}/service-keys
Content-Type: application/json

{
  "keyName": "Service Key3",
  "scopeCodes": ["product:read", "product:write"],
  "expiresAt": "2027-12-31T23:59:59"
}

> {%
    client.global.set('key_id', response.body.keyId)
 %}


### 서비스 키 목록 조회
GET {{admin_url}}/api/v1/tenants/{{tenant_id}}/service-keys
Accept: application/json

### 서비스 키 Secret 로테이션
POST {{admin_url}}/api/v1/tenants/{{tenant_id}}/service-keys/{{key_id}}/rotate
Accept: application/json

### 서비스 키 삭제
DELETE {{admin_url}}/api/v1/tenants/{{tenant_id}}/service-keys/{{key_id}}
